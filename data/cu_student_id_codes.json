{
  "university": "University of Chittagong",
  "compiled_on": "2026-09-17",
  "id_format": {
    "length": 8,
    "structure": "SS F DD NNN",
    "parts": [
      {
        "part": "SS",
        "digits": 2,
        "meaning": "Session code = last two digits of the session's ending year (2023-2024 -> 24)"
      },
      {
        "part": "F",
        "digits": 1,
        "meaning": "Faculty code"
      },
      {
        "part": "DD",
        "digits": 2,
        "meaning": "Department/institute code within the faculty"
      },
      {
        "part": "NNN",
        "digits": 3,
        "meaning": "Student serial number (001-999)"
      }
    ],
    "example": {
      "id": "24304043",
      "session": "2023-2024",
      "faculty": "Business Administration (3)",
      "department": "Marketing (04)",
      "serial": "043"
    },
    "regex": "^(\\d{2})([1-9])(\\d{2})(\\d{3})$"
  },
